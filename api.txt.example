# DeverAI API Keys — 复制为 api.txt 后填入真实值（api.txt 永不入库，已加入 .gitignore）
# 每行格式：KEY=VALUE，# 为注释
# 优先级：环境变量（DEVERAI_API_KEY 等）> api.txt > 空
# 示例：
# deverai_api_key=sk-xxxxxxxxxxxxxxxx
# deverai_search=tvly-xxxxxxxxxxxxxxxx
# deverai_drift=sk-xxxxxxxxxxxxxxxx
# deverai_dashscope=sk-xxxxxxxxxxxxxxxx

deverai_api_key=
deverai_search=
deverai_drift=
deverai_dashscope=
